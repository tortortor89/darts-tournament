# Copier ce fichier en .env et remplir les valeurs (ne jamais commiter .env)

# PostgreSQL
POSTGRES_DB=dartstournament
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# Backend
ASPNETCORE_ENVIRONMENT=Production
# Clé de signature JWT : au moins 32 caractères aléatoires (ex: openssl rand -base64 48)
JWT_KEY=CHANGE_ME
JWT_ISSUER=DartsTournament.Api
JWT_AUDIENCE=DartsTournament.Client

# CORS (origines séparées par des virgules)
CORS_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost
